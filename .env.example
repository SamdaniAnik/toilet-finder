# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random long string used to hash visitor IPs (rate limits / bans). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=change-me

# Cloudflare Turnstile (free captcha) → https://dash.cloudflare.com/?to=/:account/turnstile
# These test keys always pass; replace for production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=
